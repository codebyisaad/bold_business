{
  "info": {
    "name": "TechForce API",
    "description": "Candidate import and scoped recruiter view. Every request needs `X-Recruiter-Id`: missing → 401, unknown → 403. Expected numbers come from DECISIONS.md and assume the database was seeded with `uv run python -m app.seed`.\n\nVariables: `baseUrl` (default http://localhost:8000), `adminId` (R-101), and `csvPath`. Set `csvPath` to the absolute path of candidates_import.csv in the Postman app; with newman, run from the repo root and the relative default works.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "adminId",
      "value": "R-101"
    },
    {
      "key": "csvPath",
      "value": "candidates_import.csv"
    }
  ],
  "item": [
    {
      "name": "Recruiters",
      "item": [
        {
          "name": "List recruiters (as admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('5 recruiters', () => pm.expect(pm.response.json()).to.have.length(5));",
                  "pm.test('no emails exposed', () => pm.response.json().forEach(r => pm.expect(r).to.not.have.property('email')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Recruiter-Id",
                "value": "{{adminId}}"
              }
            ],
            "description": "The roster for the switcher: id, name, role, regions. Any known recruiter may read it.",
            "url": {
              "raw": "{{baseUrl}}/api/v1/recruiters",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "recruiters"
              ],
              "query": []
            }
          }
        },
        {
          "name": "List recruiters (no header → 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "",
            "url": {
              "raw": "{{baseUrl}}/api/v1/recruiters",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "recruiters"
              ],
              "query": []
            }
          }
        },
        {
          "name": "List recruiters (unknown → 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Recruiter-Id",
                "value": "R-999"
              }
            ],
            "description": "",
            "url": {
              "raw": "{{baseUrl}}/api/v1/recruiters",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "recruiters"
              ],
              "query": []
            }
          }
        }
      ]
    },
    {
      "name": "Import",
      "item": [
        {
          "name": "Import CSV (as admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('41 candidates written (imported on an empty DB, updated on a re-import)', () => pm.expect(r.imported + r.updated).to.eql(41));",
                  "pm.test('3 merged', () => pm.expect(r.merged).to.eql(3));",
                  "pm.test('9 rejected, at rows 35 36 37 42 47 49 50 53 54', () => pm.expect(r.rejected.map(x => x.row)).to.eql([35, 36, 37, 42, 47, 49, 50, 53, 54]));",
                  "pm.test('ID collision names the owning row', () => pm.expect(r.rejected[7].reason).to.eql('candidate_id C-1010 already belongs to row 11'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Recruiter-Id",
                "value": "{{adminId}}"
              }
            ],
            "description": "Multipart field `file`. Admin only. Returns {imported, merged, updated, rejected:[{row, reason}]}.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{csvPath}}"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/candidates/import",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "candidates",
                "import"
              ]
            }
          }
        },
        {
          "name": "Import CSV (recruiter, not admin → 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Recruiter-Id",
                "value": "R-102"
              }
            ],
            "description": "",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{csvPath}}"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/candidates/import",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "candidates",
                "import"
              ]
            }
          }
        },
        {
          "name": "Import CSV (no header → 401)",
