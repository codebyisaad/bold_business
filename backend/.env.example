# Read by app.config. Copy to backend/.env; passwords must match the root .env.
# The API and the tests connect as techforce_app (no superuser, owns nothing).
DATABASE_URL=postgresql+psycopg://techforce_app:change-me-app@localhost:5433/techforce
TEST_DATABASE_URL=postgresql+psycopg://techforce_app:change-me-app@localhost:5433/techforce_test
# Only app.db.apply_schema uses these, to create the tables as their owner.
OWNER_DATABASE_URL=postgresql+psycopg://techforce_owner:change-me-owner@localhost:5433/techforce
TEST_OWNER_DATABASE_URL=postgresql+psycopg://techforce_owner:change-me-owner@localhost:5433/techforce_test
